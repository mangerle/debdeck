[Desktop Entry]
Type=Application
Version=1.0
Name=DebDeck
Name[zh_CN]=DebDeck
GenericName=Application Manager
GenericName[zh_CN]=应用管理器
Comment=View, open and uninstall applications, download or repack deb packages
Comment[zh_CN]=查看、打开和卸载应用，在线下载或离线提取 deb 安装包
Exec=debdeck %f
Icon=debdeck
Terminal=false
Categories=PackageManager;Settings;
MimeType=application/vnd.debian.binary-package;application/x-deb;
Keywords=debdeck;app;application;package;deb;dpkg;apt;uninstall;manager;
Keywords[zh_CN]=应用;软件;软件包;卸载;安装包;管理器;
StartupNotify=true
StartupWMClass=debdeck
